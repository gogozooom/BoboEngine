<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Moq" Version="4.21.0" />
    <PackageReference Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BoboEngine\BoboEngine.csproj" />
  </ItemGroup>

  <Target Name="CopyBinDependencies" AfterTargets="Build">
    <ItemGroup>
      <BinDepFiles Include="$(ProjectDir)..\BoboEngine\Bin-Dep\**\*"/>
    </ItemGroup>
	  
	<Message Text="Copying @(BinDepFiles->Count()) files from Bin-Dep to $(TargetDir)" Importance="high" />

	<Copy SourceFiles="@(BinDepFiles)"
      DestinationFiles="@(BinDepFiles->'$(TargetDir)%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true"/>
  </Target> 

</Project>
